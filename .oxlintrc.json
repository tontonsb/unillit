{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": [
		"dist/**",
		"dist-ssr/**",
		"coverage/**",
		".claude/**",
		".github/**"
	],
	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"oxc",
		"vue",
		"vitest"
	],
	"env": {
		"browser": true
	},
	"categories": {
		"correctness": "error"
	}
}
